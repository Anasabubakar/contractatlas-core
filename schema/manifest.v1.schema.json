{
  "title": "ContractAtlas manifest v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1"
    },
    "protocol": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "description": {
          "type": "string",
          "maxLength": 1000
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "enum": [
            "mainnet",
            "testnet",
            "futurenet",
            "standalone"
          ]
        },
        "passphrase": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "name",
        "passphrase"
      ],
      "additionalProperties": false
    },
    "contracts": {
      "minItems": 1,
      "maxItems": 200,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "declaredWasmHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "declaredSourceCommit": {
            "type": "object",
            "properties": {
              "repository": {
                "type": "string",
                "format": "uri"
              },
              "commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            },
            "required": [
              "repository",
              "commit"
            ],
            "additionalProperties": false
          },
          "audits": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "auditor": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "report": {
                  "type": "string",
                  "format": "uri"
                },
                "date": {
                  "type": "string",
                  "format": "date",
                  "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                },
                "reviewedWasmHashes": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "reviewedSourceCommit": {
                  "type": "object",
                  "properties": {
                    "repository": {
                      "type": "string",
                      "format": "uri"
                    },
                    "commit": {
                      "type": "string",
                      "pattern": "^[0-9a-f]{40}$"
                    }
                  },
                  "required": [
                    "repository",
                    "commit"
                  ],
                  "additionalProperties": false
                },
                "limitations": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                }
              },
              "required": [
                "id",
                "auditor",
                "report",
                "date"
              ],
              "additionalProperties": false
            }
          },
          "privileges": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "role": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "holder": {
                  "type": "string"
                },
                "description": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "role",
                "holder"
              ],
              "additionalProperties": false
            }
          },
          "dependencies": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "contractId": {
                  "type": "string"
                },
                "note": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "name"
              ],
              "additionalProperties": false
            }
          },
          "limitations": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          }
        },
        "required": [
          "id",
          "name"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "protocol",
    "network",
    "contracts"
  ],
  "additionalProperties": false
}
