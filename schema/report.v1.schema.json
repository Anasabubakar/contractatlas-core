{
  "title": "ContractAtlas report v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reportVersion": {
      "type": "string",
      "const": "1"
    },
    "tool": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false
    },
    "observedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
    },
    "manifest": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "string",
          "const": "1"
        },
        "protocol": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "network": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "passphrase": {
              "type": "string"
            }
          },
          "required": [
            "name",
            "passphrase"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "protocol",
        "sha256",
        "network"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "rpcOrigin": {
          "type": [
            "string",
            "null"
          ]
        },
        "latestLedger": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "network": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "match"
                },
                "expected": {
                  "type": "string"
                },
                "observed": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "expected",
                "observed"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "mismatch"
                },
                "expected": {
                  "type": "string"
                },
                "observed": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "expected",
                "observed"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "const": "unavailable"
                },
                "expected": {
                  "type": "string"
                },
                "detail": {
                  "type": "string"
                }
              },
              "required": [
                "status",
                "expected",
                "detail"
              ],
              "additionalProperties": false
            }
          ]
        }
      },
      "required": [
        "rpcOrigin",
        "latestLedger",
        "network"
      ],
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "properties": {
        "match": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "drift": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "incomplete": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unavailable": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "match",
        "drift",
        "incomplete",
        "unavailable"
      ],
      "additionalProperties": false
    },
    "overall": {
      "type": "string",
      "enum": [
        "match",
        "drift",
        "incomplete",
        "unavailable"
      ]
    },
    "contracts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "match",
              "drift",
              "incomplete",
              "unavailable"
            ]
          },
          "live": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "wasm"
                  },
                  "wasmHash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "required": [
                  "kind",
                  "wasmHash"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "stellar_asset"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "other_executable"
                  },
                  "detail": {
                    "type": "string"
                  }
                },
                "required": [
                  "kind",
                  "detail"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "not_live"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "unavailable"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false
              }
            ]
          },
          "declared": {
            "type": "object",
            "properties": {
              "wasmHash": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "sourceCommit": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "wasmHash",
              "sourceCommit"
            ],
            "additionalProperties": false
          },
          "audits": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "auditor": {
                  "type": "string"
                },
                "report": {
                  "type": "string"
                },
                "date": {
                  "type": "string"
                },
                "coversLiveArtifact": {
                  "type": "boolean"
                },
                "reviewedWasmHashes": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                },
                "reviewedSourceCommit": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "limitations": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "id",
                "auditor",
                "report",
                "date",
                "coversLiveArtifact",
                "reviewedWasmHashes",
                "reviewedSourceCommit",
                "limitations"
              ],
              "additionalProperties": false
            }
          },
          "declarations": {
            "type": "object",
            "properties": {
              "privileges": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "role": {
                      "type": "string"
                    },
                    "holder": {
                      "type": "string"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "role",
                    "holder",
                    "description"
                  ],
                  "additionalProperties": false
                }
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string"
                    },
                    "contractId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "note": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  },
                  "required": [
                    "name",
                    "contractId",
                    "note"
                  ],
                  "additionalProperties": false
                }
              },
              "limitations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "privileges",
              "dependencies",
              "limitations"
            ],
            "additionalProperties": false
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "enum": [
                    "network_mismatch",
                    "network_unavailable",
                    "ledger_unavailable",
                    "entry_not_live",
                    "executable_not_wasm",
                    "no_declared_artifact",
                    "live_hash_differs_from_declared",
                    "live_artifact_outside_audit_scope",
                    "no_audit_reference",
                    "audit_scope_unmapped_to_artifact",
                    "live_artifact_in_audit_scope",
                    "declared_source_commit_unverified"
                  ]
                },
                "severity": {
                  "type": "string",
                  "enum": [
                    "info",
                    "warning",
                    "error"
                  ]
                },
                "message": {
                  "type": "string"
                },
                "evidence": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": [
                      "string",
                      "number",
                      "boolean",
                      "null"
                    ]
                  }
                }
              },
              "required": [
                "code",
                "severity",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "status",
          "live",
          "declared",
          "audits",
          "declarations",
          "findings"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "reportVersion",
    "tool",
    "observedAt",
    "manifest",
    "source",
    "summary",
    "overall",
    "contracts",
    "limitations"
  ],
  "additionalProperties": false
}
